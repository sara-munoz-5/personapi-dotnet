@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="text-danger">Error</h1>
<h2 class="text-danger">Ocurrió un error al procesar la solicitud.</h2>
<p>Intente de nuevo más tarde. Si el problema continúa, informe al equipo el identificador de la solicitud.</p>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Identificador de la solicitud:</strong> <code>@Model.RequestId</code>
    </p>
}

<a class="btn btn-secondary" asp-controller="Home" asp-action="Index">Volver al inicio</a>
