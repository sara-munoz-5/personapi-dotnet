@model personapi_dotnet.Models.ViewModels.Estudios.EstudiosCrearViewModel
@{
    ViewData["Title"] = "Nuevo estudio";
}

<h1>Nuevo estudio</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-controller="EstudiosCrear" asp-action="Crear" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="mb-3">
                <label asp-for="CcPer" class="form-label"></label>
                <select asp-for="CcPer" asp-items="Model.Personas" class="form-select">
                    <option value="">-- Seleccione una persona --</option>
                </select>
                <span asp-validation-for="CcPer" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="IdProf" class="form-label"></label>
                <select asp-for="IdProf" asp-items="Model.Profesiones" class="form-select">
                    <option value="">-- Seleccione una profesión --</option>
                </select>
                <span asp-validation-for="IdProf" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Univer" class="form-label"></label>
                <input asp-for="Univer" class="form-control" />
                <span asp-validation-for="Univer" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Fecha" class="form-label"></label>
                <input asp-for="Fecha" class="form-control" />
                <span asp-validation-for="Fecha" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Guardar</button>
            <a class="btn btn-secondary" asp-controller="EstudiosListar" asp-action="Listar">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
