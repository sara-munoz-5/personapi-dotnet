@model personapi_dotnet.Models.ViewModels.Estudios.EstudiosListarViewModel
@{
    ViewData["Title"] = "Estudios";
}

<h1>Estudios</h1>

@if (!string.IsNullOrEmpty(Model.Mensaje))
{
    <div class="alert alert-success" role="status">@Model.Mensaje</div>
}

<p>
    <a class="btn btn-primary" asp-controller="EstudiosCrear" asp-action="Crear">Nuevo estudio</a>
    <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Index">Volver al inicio</a>
</p>

@if (Model.Estudios.Count == 0)
{
    <div class="alert alert-info">No hay estudios registrados.</div>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th scope="col">Persona</th>
                <th scope="col">Profesión</th>
                <th scope="col">Universidad</th>
                <th scope="col">Fecha</th>
                <th scope="col">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in Model.Estudios)
            {
                <tr>
                    <td>@e.Persona</td>
                    <td>@e.Profesion</td>
                    <td>@(e.Univer ?? "—")</td>
                    <td>@(e.Fecha?.ToString("dd/MM/yyyy") ?? "—")</td>
                    <td>
                        <a class="btn btn-sm btn-outline-info" asp-controller="EstudiosDetalle" asp-action="Detalle" asp-route-idProf="@e.IdProf" asp-route-ccPer="@e.CcPer">Detalle</a>
                        <a class="btn btn-sm btn-outline-primary" asp-controller="EstudiosEditar" asp-action="Editar" asp-route-idProf="@e.IdProf" asp-route-ccPer="@e.CcPer">Editar</a>
                        <a class="btn btn-sm btn-outline-danger" asp-controller="EstudiosEliminar" asp-action="Eliminar" asp-route-idProf="@e.IdProf" asp-route-ccPer="@e.CcPer">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
