@model personapi_dotnet.Models.ViewModels.Estudios.EstudiosDetalleViewModel
@{
    ViewData["Title"] = "Detalle del estudio";
}

<h1>Detalle del estudio</h1>

<dl class="row">
    <dt class="col-sm-3">Persona</dt>
    <dd class="col-sm-9"><a asp-controller="PersonaDetalle" asp-action="Detalle" asp-route-cc="@Model.CcPer">@Model.Persona</a> (cédula @Model.CcPer)</dd>
    <dt class="col-sm-3">Profesión</dt>
    <dd class="col-sm-9">@Model.Profesion (id @Model.IdProf)</dd>
    <dt class="col-sm-3">Universidad</dt>
    <dd class="col-sm-9">@(Model.Univer ?? "—")</dd>
    <dt class="col-sm-3">Fecha</dt>
    <dd class="col-sm-9">@(Model.Fecha?.ToString("dd/MM/yyyy") ?? "—")</dd>
</dl>

<p>
    <a class="btn btn-primary" asp-controller="EstudiosEditar" asp-action="Editar" asp-route-idProf="@Model.IdProf" asp-route-ccPer="@Model.CcPer">Editar</a>
    <a class="btn btn-secondary" asp-controller="EstudiosListar" asp-action="Listar">Volver</a>
</p>
