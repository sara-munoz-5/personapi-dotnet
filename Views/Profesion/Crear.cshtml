@model personapi_dotnet.Models.ViewModels.Profesion.ProfesionCrearViewModel
@{
    ViewData["Title"] = "Nueva profesión";
}

<h1>Nueva profesión</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-controller="ProfesionCrear" asp-action="Crear" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="mb-3">
                <label asp-for="Id" class="form-label"></label>
                <input asp-for="Id" class="form-control" />
                <span asp-validation-for="Id" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Nom" class="form-label"></label>
                <input asp-for="Nom" class="form-control" />
                <span asp-validation-for="Nom" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Des" class="form-label"></label>
                <textarea asp-for="Des" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Des" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Guardar</button>
            <a class="btn btn-secondary" asp-controller="ProfesionListar" asp-action="Listar">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
