@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="text-danger">Error.</h1>
<h2 class="text-danger">Ocurrió un error al procesar su solicitud.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Id de la solicitud:</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>Modo de desarrollo</h3>
<p>
    En el entorno <strong>Development</strong> se muestra información más detallada del error.
</p>
<p>
    <strong>El entorno Development no debe activarse en aplicaciones desplegadas</strong>, porque puede mostrar
    información sensible de las excepciones a los usuarios. Para depurar en local, asigne <strong>Development</strong>
    a la variable de entorno <strong>ASPNETCORE_ENVIRONMENT</strong> y reinicie la aplicación.
</p>
