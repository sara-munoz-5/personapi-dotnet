@model Persona
@{
    ViewData["Title"] = "Detalle de persona";
}

<h1>@Model.Nombre @Model.Apellido</h1>

<dl class="row">
    <dt class="col-sm-3">Cédula</dt>
    <dd class="col-sm-9">@Model.Cc</dd>
    <dt class="col-sm-3">Nombre</dt>
    <dd class="col-sm-9">@Model.Nombre</dd>
    <dt class="col-sm-3">Apellido</dt>
    <dd class="col-sm-9">@Model.Apellido</dd>
    <dt class="col-sm-3">Género</dt>
    <dd class="col-sm-9">@Generos.Texto(Model.Genero)</dd>
    <dt class="col-sm-3">Edad</dt>
    <dd class="col-sm-9">@(Model.Edad?.ToString() ?? "Sin dato")</dd>
</dl>

<h2 class="h4 mt-4">Estudios</h2>
@if (Model.Estudios.Count == 0)
{
    <p class="text-muted">No tiene estudios registrados.</p>
}
else
{
    <table class="table table-sm">
        <thead>
            <tr>
                <th>Profesión</th>
                <th>Universidad</th>
                <th>Fecha</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var estudio in Model.Estudios)
            {
                <tr>
                    <td>@(estudio.IdProfNavigation?.Nom ?? estudio.IdProf.ToString())</td>
                    <td>@estudio.Univer</td>
                    <td>@estudio.Fecha?.ToString("dd/MM/yyyy")</td>
                </tr>
            }
        </tbody>
    </table>
}

<h2 class="h4 mt-4">Teléfonos</h2>
@if (Model.Telefonos.Count == 0)
{
    <p class="text-muted">No tiene teléfonos registrados.</p>
}
else
{
    <table class="table table-sm">
        <thead>
            <tr>
                <th>Número</th>
                <th>Operador</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var telefono in Model.Telefonos)
            {
                <tr>
                    <td>@telefono.Num</td>
                    <td>@telefono.Oper</td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Cc" class="btn btn-primary">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
