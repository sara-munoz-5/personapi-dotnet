@model Persona
@{
    ViewData["Title"] = "Borrar persona";
    var dependientes = Model.Estudios.Count + Model.Telefonos.Count;
}

<h1>Borrar persona</h1>

<partial name="_Mensajes" />

@if (dependientes > 0)
{
    <div class="alert alert-warning" role="alert">
        Al borrar esta persona también se borrarán <strong>@Model.Estudios.Count estudio(s)</strong>
        y <strong>@Model.Telefonos.Count teléfono(s)</strong> asociados.
    </div>
}

<p>¿Seguro que desea borrar esta persona?</p>

<dl class="row">
    <dt class="col-sm-3">Cédula</dt>
    <dd class="col-sm-9">@Model.Cc</dd>
    <dt class="col-sm-3">Nombre</dt>
    <dd class="col-sm-9">@Model.Nombre @Model.Apellido</dd>
    <dt class="col-sm-3">Género</dt>
    <dd class="col-sm-9">@Generos.Texto(Model.Genero)</dd>
    <dt class="col-sm-3">Edad</dt>
    <dd class="col-sm-9">@(Model.Edad?.ToString() ?? "Sin dato")</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.Cc" method="post">
    <button type="submit" class="btn btn-danger">Borrar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
