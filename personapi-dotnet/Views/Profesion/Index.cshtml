@model List<Profesion>
@{
    ViewData["Title"] = "Profesiones";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Profesiones</h1>
    <a asp-action="Create" class="btn btn-primary">Nueva profesión</a>
</div>

<partial name="_Mensajes" />

@if (Model.Count == 0)
{
    <p class="text-muted">No hay profesiones registradas.</p>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nombre</th>
                <th>Descripción</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var profesion in Model)
            {
                <tr>
                    <td>@profesion.Id</td>
                    <td>@profesion.Nom</td>
                    <td>@profesion.Des</td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Details" asp-route-id="@profesion.Id" class="btn btn-sm btn-outline-secondary">Detalles</a>
                        <a asp-action="Edit" asp-route-id="@profesion.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                        <a asp-action="Delete" asp-route-id="@profesion.Id" class="btn btn-sm btn-outline-danger">Borrar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
