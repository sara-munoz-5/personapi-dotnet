@model Profesion
@{
    ViewData["Title"] = "Detalle de profesión";
}

<h1>@Model.Nom</h1>

<dl class="row">
    <dt class="col-sm-3">Id</dt>
    <dd class="col-sm-9">@Model.Id</dd>
    <dt class="col-sm-3">Nombre</dt>
    <dd class="col-sm-9">@Model.Nom</dd>
    <dt class="col-sm-3">Descripción</dt>
    <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Des) ? "Sin descripción" : Model.Des)</dd>
    <dt class="col-sm-3">Estudios registrados</dt>
    <dd class="col-sm-9">@Model.Estudios.Count</dd>
</dl>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
