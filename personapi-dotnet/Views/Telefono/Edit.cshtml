@model personapi_dotnet.ViewModels.TelefonoFormViewModel
@{
    ViewData["Title"] = "Editar teléfono";
}

<h1>Editar teléfono</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" asp-route-id="@Model.Telefono.Num" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Telefono.Num" class="form-label"></label>
                @* El número es la llave: se muestra pero no se envía ni se edita *@
                <input value="@Model.Telefono.Num" class="form-control" readonly disabled />
            </div>
            <div class="mb-3">
                <label asp-for="Telefono.Oper" class="form-label"></label>
                <input asp-for="Telefono.Oper" class="form-control" />
                <span asp-validation-for="Telefono.Oper" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Telefono.Duenio" class="form-label"></label>
                <select asp-for="Telefono.Duenio" asp-items="Model.Personas" class="form-select">
                    <option value="">-- Seleccione el dueño --</option>
                </select>
                <span asp-validation-for="Telefono.Duenio" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Guardar cambios</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
