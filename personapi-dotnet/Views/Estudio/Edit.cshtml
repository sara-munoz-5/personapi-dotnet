@model personapi_dotnet.ViewModels.EstudioFormViewModel
@{
    ViewData["Title"] = "Editar estudio";
    var estudio = Model.Estudio;
}

<h1>Editar estudio</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" asp-route-idProf="@estudio.IdProf" asp-route-ccPer="@estudio.CcPer" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            @* Persona y profesión forman la llave: cambiarlas sería otro registro, por eso son de solo lectura *@
            <div class="mb-3">
                <label asp-for="Estudio.CcPer" class="form-label"></label>
                <input value="@estudio.CcPerNavigation?.Nombre @estudio.CcPerNavigation?.Apellido" class="form-control" readonly disabled />
            </div>
            <div class="mb-3">
                <label asp-for="Estudio.IdProf" class="form-label"></label>
                <input value="@estudio.IdProfNavigation?.Nom" class="form-control" readonly disabled />
            </div>
            <div class="mb-3">
                <label asp-for="Estudio.Univer" class="form-label"></label>
                <input asp-for="Estudio.Univer" class="form-control" />
                <span asp-validation-for="Estudio.Univer" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Estudio.Fecha" class="form-label"></label>
                <input asp-for="Estudio.Fecha" type="date" max="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control" />
                <span asp-validation-for="Estudio.Fecha" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Guardar cambios</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
